# Irela backend configuration template.
#
# The backend reads configuration from the PROCESS ENVIRONMENT only; it does not
# load this file itself. Copy it to `.env` (git-ignored), fill it in, and either:
#   - point a systemd unit at it:   EnvironmentFile=/etc/apex/backend.env
#   - or export it in a dev shell:  set -a; . ./.env; set +a
#
# Never commit a filled-in copy. Variables marked SECRET must not appear in the
# repository, in an image layer, on a command line, or in logs.
# Deployment guide: backend/DEPLOYMENT.md.

# --- Transcription providers -------------------------------------------------
# SECRET. Primary provider (Deepgram). Without it, requests have no primary provider.
DEEPGRAM_API_KEY=
# SECRET. Backup provider the router fails over to. Unset = no backup.
ASSEMBLYAI_API_KEY=

# --- Core ---------------------------------------------------------------------
# SQLite database for metering, installations and provider health.
# Default: backend/metering.sqlite3. Use a persistent path in production.
# Leave commented out rather than empty: an empty value is used as-is.
# METERING_DB=/var/lib/apex/metering.sqlite3
# Kill switch: false stops all provider spending immediately (503, not retryable).
TRANSCRIPTION_ENABLED=true
# Hard stop on estimated provider spend over 24 h (INR). Unset = no hard stop.
DAILY_BUDGET_INR=
# Log a USAGE_ALERT once when 24 h spend crosses this (INR).
USAGE_ALERT_INR=
USAGE_ALERT_WINDOW_HOURS=

# --- Per-installation and registration limits (defaults shown) ----------------
CLIENT_REQUESTS_PER_MINUTE=6
CLIENT_TRANSCRIPTIONS_PER_DAY=40
REGISTRATIONS_PER_IP_PER_HOUR=10
REGISTRATIONS_PER_HOUR=200

# --- Audio limits ---------------------------------------------------------------
# Authoritative limits live in shared/limits.json (3600 s, 100 MB).
# These overrides may only TIGHTEN them; leave unset in production.
# MAX_UPLOAD_BYTES=
# MAX_AUDIO_SECONDS=

# --- Free tier (defaults in comments) -------------------------------------------
# FREE_MONTHLY_SECONDS=1200
# FREE_ALLOWANCE_TIMEZONE=UTC
# FREE_ALLOWANCE_UNKNOWN_FLOOR_BPS=16000
FREE_DAILY_NETWORK_SECONDS=3600
FREE_DAILY_BUDGET_INR=100
# FREE_TIER_SALT_RETENTION_DAYS=7
# FREE_BUDGET_ALERT_FRACTION=0.8
# FREE_REGISTRATION_ALERT_PER_HOUR=50

# --- Owner plan (optional) ------------------------------------------------------
# SECRET-ish: SHA-256 (64 hex chars) of the owner claim code, never the code itself.
# Generate with: python owner_admin.py hash      Unset = owner claiming disabled.
OWNER_CLAIM_CODE_SHA256=
# OWNER_MAX_INSTALLATIONS=2
# OWNER_DAILY_SECONDS=14400
# OWNER_MONTHLY_SECONDS=108000
# OWNER_TRANSCRIPTIONS_PER_DAY=150
# OWNER_REQUESTS_PER_MINUTE=6

# --- Operator access -------------------------------------------------------------
# SECRET. When set, GET /v1/usage requires "Authorization: Bearer <ADMIN_TOKEN>".
# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Google Play billing / Pro plan (optional, off unless all four are set) -------
# BILLING_ENABLED=true
# PLAY_PACKAGE_NAME=com.whispercppdemo
# SECRET: path to a Google Cloud service-account JSON key file kept OUTSIDE the repo.
# PLAY_SERVICE_ACCOUNT_FILE=/etc/apex/play-sa.json
# SECRET: Fernet key for stored purchase tokens. Generate with: python billing_admin.py key
# BILLING_TOKEN_KEY=
# PLAY_RTDN_AUDIENCE=https://<your-backend-host>/v1/billing/rtdn
# PLAY_RTDN_SERVICE_ACCOUNT=<push-service-account-email>
# PLAY_PRO_PRODUCT_ID=irela_pro
# PLAY_PRO_MONTHLY_BASE_PLAN=monthly
# PLAY_PRO_ANNUAL_BASE_PLAN=annual
# PRO_MONTHLY_SECONDS=18000
# PRO_DAILY_SECONDS=7200
# PRO_TRANSCRIPTIONS_PER_DAY=60
# PRO_REQUESTS_PER_MINUTE=6
# PRO_TRANSFERS_PER_30_DAYS=3

# --- Provider router / health tuning (defaults in comments) -----------------------
# ROUTER_MAX_ATTEMPTS=2
# ROUTER_BACKOFF_BASE_S=1.0
# ROUTER_DEADLINE_S=280
# ROUTER_PROVIDER_TIMEOUT_S=240
# PROVIDER_TRANSIENT_TRIP=3
# PROVIDER_TRANSIENT_RECHECK_S=30
# PROVIDER_CREDENTIAL_RECHECK_S=300
# PROVIDER_QUOTA_RECHECK_S=900
# PROVIDER_MAX_RECHECK_S=3600
# PROVIDER_PROBE_INTERVAL_S=300
# HANDLER_WAIT_S=100
# STATUS_WAIT_S=25
