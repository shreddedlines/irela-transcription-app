# Normalise line endings in the repository; check out natively per platform.
* text=auto

# Shell scripts must keep LF or they fail under bash (including on Linux servers).
*.sh      text eol=lf
gradlew   text eol=lf
# Windows scripts keep CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary files
*.jar     binary
*.ttf     binary
*.png     binary
*.webp    binary
